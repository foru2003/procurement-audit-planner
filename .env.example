# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project Settings > Environment Variables.

# Google AI Studio key (free tier). Used only for Live mode.
GOOGLE_GENERATIVE_AI_API_KEY=

# Model used in Live mode. gemini-3.8-flash: stable, supports function calling,
# free of charge on the Gemini API free tier (checked against Google's docs on
# 2026-10-13). Change this value to switch models; no code change needed.
MODEL_NAME=gemini-3.8-flash

# Passcode that unlocks Live mode. Replay mode needs none.
APP_PASSCODE=

# Vercel Blob read/write token (created when you add a Blob store to the project).
BLOB_READ_WRITE_TOKEN=
