# Copy to .streamlit/secrets.toml for local runs; on Streamlit Community Cloud paste
# the same keys into App settings > Secrets. Never commit real values.

# Google AI Studio key (free tier). GEMINI_API_KEY is accepted as an alternative name.
GOOGLE_API_KEY = ""

# Model for Live mode. gemini-3.8-flash: stable, function calling, free of charge on
# the Gemini API free tier (checked against Google's docs, 2026-10-13).
MODEL_NAME = "gemini-3.8-flash"

# Tried in order if MODEL_NAME is unavailable or has no free quota (comma separated).
MODEL_FALLBACKS = "gemini-3.6-flash,gemini-3.5-flash-lite,gemini-2.5-flash"

# Passcode that unlocks Live mode and the connection test. Replay needs none.
APP_PASSCODE = ""

# Optional. A "call" is one model request.
SESSION_CALL_CAP = 130
DAILY_CALL_CAP = 300
TURN_PAUSE_SECONDS = 4
